# Copy to .env in the project root; adjust only for your machine.
# Shell variables take precedence over .env, which takes precedence over YAML.
CONFIG_PATH=config/config.yaml
DATASETS_TASKS_DATA=data
MODEL_DIR=models
LOG_LEVEL=INFO
# No API key is needed for the local CSV or the required local LLM.
# Do not put credentials in this shared template.
# Stage 6: never commit actual database credentials.
SERVING_BUNDLE=models/serving
SERVICE_HOST=127.0.0.1
SERVICE_PORT=8080
# DATABASE_URL=postgresql://hotel:<password>@127.0.0.1:5432/hotel
# POSTGRES_PASSWORD=<local-password>
